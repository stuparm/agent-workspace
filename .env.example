# wt: files to symlink from the main checkout into each new worktree.
# Copy to .env (gitignored) to customize.

# Exact paths relative to the repo root, one per line
WT_SYMLINK_FILES="
.env
.env.local
CLAUDE.local.md
"

# `find -name` patterns, matched recursively (directory structure is kept), one per line
WT_SYMLINK_PATTERNS="
*.local.yaml
*.local.json
"
